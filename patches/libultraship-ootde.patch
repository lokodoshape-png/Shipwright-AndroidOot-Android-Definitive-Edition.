diff --git a/src/graphic/Fast3D/shaders/opengl/default.shader.fs b/src/graphic/Fast3D/shaders/opengl/default.shader.fs
index b15e159..ac33ba0 100644
--- a/src/graphic/Fast3D/shaders/opengl/default.shader.fs
+++ b/src/graphic/Fast3D/shaders/opengl/default.shader.fs
@@ -43,6 +43,8 @@ out vec4 vOutColor;
 
 uniform int frame_count;
 uniform float noise_scale;
+// OOT D.E.: 3DS-style lighting filter. x = strength (0 = off).
+uniform vec4 color_grade;
 
 #define TEX_OFFSET(off) @{texture}(tex, texCoord - off / texSize)
 #define WRAP(x, low, high) mod((x)-(low), (high)-(low)) + (low)
@@ -178,6 +180,20 @@ void main() {
         @end
     @end
 
+    // OOT D.E.: 3DS-style lighting filter: livelier colors, a little more contrast and light, warm tint and
+    // softly glowing highlights. color_grade.x is the strength chosen in the menu (0 = off).
+    if (color_grade.x > 0.0) {
+        float cgS = color_grade.x;
+        vec3 cg = texel.rgb;
+        float cgL = dot(cg, vec3(0.299, 0.587, 0.114));
+        cg = mix(vec3(cgL), cg, 1.0 + 0.35 * cgS);
+        cg = (cg - 0.5) * (1.0 + 0.12 * cgS) + 0.5;
+        cg *= 1.0 + 0.08 * cgS;
+        cg *= vec3(1.0 + 0.05 * cgS, 1.0 + 0.015 * cgS, 1.0 - 0.04 * cgS);
+        cg += vec3(smoothstep(0.55, 1.0, cgL) * 0.07 * cgS);
+        texel.rgb = clamp(cg, 0.0, 1.0);
+    }
+
     @if(o_texture_edge && o_alpha)
         if (texel.a > 0.19) texel.a = 1.0; else discard;
     @end
